<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Installed by install.sh as /Library/LaunchDaemons/com.traintimes.server.plist
  (root:admin, mode 640). Replace every XXXX, then run install.sh again to
  start it. cloudflared on this Mac forwards https://<hostname> to
  http://127.0.0.1:8080, so HOST stays 127.0.0.1.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.traintimes.server</string>

    <key>UserName</key>
    <string>traintimes</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/traintimes/TrainTimesServer</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/usr/local/traintimes</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>APNS_KEY_PATH</key>
        <string>/usr/local/traintimes/AuthKey_XXXX.p8</string>
        <key>APNS_KEY_ID</key>
        <string>XXXX</string>
        <key>APNS_TEAM_ID</key>
        <string>XUU899AG4D</string>
        <key>APNS_TOPIC</key>
        <string>com.rtrainwidget.app.push-type.liveactivity</string>
        <!-- on: App Attest. off (development only, e.g. the simulator) also needs
             API_SECRET (openssl rand -hex 32) -->
        <key>ATTEST_MODE</key>
        <string>on</string>
        <!-- production (TestFlight and App Store builds), development (builds
             from Xcode), or both -->
        <key>ATTEST_ENVIRONMENT</key>
        <string>production</string>
        <key>APP_ID</key>
        <string>XUU899AG4D.com.rtrainwidget.app</string>
        <key>DATA_DIR</key>
        <string>/usr/local/traintimes/data</string>
        <key>HOST</key>
        <string>127.0.0.1</string>
        <key>PORT</key>
        <string>8080</string>
        <key>POLL_SECONDS</key>
        <string>20</string>
        <!-- A push when the train comes more than PUSH_EARLIER_SECONDS sooner
             or PUSH_LATER_SECONDS later, or a following one moves
             PUSH_FOLLOWING_SECONDS; a low-priority one after REFRESH_SECONDS -->
        <key>PUSH_EARLIER_SECONDS</key>
        <string>15</string>
        <key>PUSH_LATER_SECONDS</key>
        <string>60</string>
        <key>PUSH_FOLLOWING_SECONDS</key>
        <string>60</string>
        <key>REFRESH_SECONDS</key>
        <string>300</string>
        <key>PUSH_CONCURRENCY</key>
        <string>100</string>
        <key>MAX_REGISTRATIONS</key>
        <string>100000</string>
        <key>MAX_REGISTRATIONS_PER_KEY</key>
        <string>5</string>
        <!-- RATE_LIMIT_BURST, left out, is the same as this -->
        <key>RATE_LIMIT_PER_MINUTE</key>
        <string>30</string>
        <key>MAX_CHALLENGES</key>
        <string>10000</string>
        <key>MAX_CHALLENGES_PER_IP</key>
        <string>10</string>
        <key>MAX_KEYS_PER_IP_PER_DAY</key>
        <string>10</string>
        <!-- Google's Routes API key, for GET /routes (directions shared to the
             app). Leave it out, or empty, to turn that off -->
        <key>GOOGLE_ROUTES_API_KEY</key>
        <string></string>
        <!-- MTA Bus Time's API key, for GET /buses (the next buses for a
             route's bus rides). Leave it out, or empty, to turn that off -->
        <key>BUS_TIME_API_KEY</key>
        <string></string>
        <!-- 1 to log every push, not just each pass's totals -->
        <key>LOG_PUSHES</key>
        <string>0</string>
        <!-- StandardOutPath below: the server moves to the new file once
             newsyslog has rotated it -->
        <key>LOG_FILE</key>
        <string>/usr/local/traintimes/server.log</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/usr/local/traintimes/server.log</string>
    <key>StandardErrorPath</key>
    <string>/usr/local/traintimes/server.log</string>

    <key>Umask</key>
    <integer>63</integer>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <!-- At most one restart every 30 s, e.g. while a setting is wrong -->
    <key>ThrottleInterval</key>
    <integer>30</integer>
</dict>
</plist>
